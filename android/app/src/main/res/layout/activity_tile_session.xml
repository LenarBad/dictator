<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dictator_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/dictator_text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/tile_session_recording"
        android:textColor="@color/dictator_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/tile_session_hint"
        android:textColor="@color/dictator_text_muted"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/transcriptScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@color/dictator_surface"
        android:fillViewport="true"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dictator_text"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/levelBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="28dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/dictator_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:enabled="false"
        android:text="@string/tile_session_stop"
        android:textAllCaps="false"
        app:backgroundTint="@color/dictator_accent"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCollapse"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/tile_session_collapse"
        android:textAllCaps="false"
        android:textColor="@color/dictator_text"
        app:cornerRadius="12dp"
        app:strokeColor="@color/dictator_text_muted" />
</LinearLayout>
