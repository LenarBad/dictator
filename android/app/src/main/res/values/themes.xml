<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dictator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dictator_accent</item>
        <item name="colorPrimaryVariant">@color/dictator_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/setup_bg</item>
        <item name="android:navigationBarColor">@color/setup_bg</item>
        <item name="android:windowBackground">@color/setup_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Dictator.TileSession" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dictator_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/dictator_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.Dictator.ImeKey" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/dictator_key</item>
        <item name="android:textColor">@color/dictator_text</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
