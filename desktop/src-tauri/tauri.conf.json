{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictator",
  "version": "0.1.0",
  "identifier": "io.lenar.dictator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Dictator",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "create": false,
        "visible": true,
        "skipTaskbar": true,
        "resizable": true,
        "transparent": true,
        "theme": "Dark",
        "titleBarStyle": "Visible",
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/gigaam/encoder.int8.onnx",
      "resources/gigaam/decoder.onnx",
      "resources/gigaam/joiner.onnx",
      "resources/gigaam/tokens.txt",
      "resources/gigaam/LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
